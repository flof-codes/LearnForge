# LearnForge Environment Variables
# Copy to .env and set production values:  cp .env.example .env

# ── API Authentication (required for production) ─────────────────────────
# Secret key for signing JWT tokens. MUST be changed in production.
JWT_SECRET=your-secure-jwt-secret-here

# JWT token expiration time (default: 7d)
# JWT_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string. Docker Compose sets this automatically.
# Only needed when running api/ or mcp/ outside Docker.
# DATABASE_URL=postgresql://learnforge:learnforge@localhost:5432/learnforge

# ── Server Ports ─────────────────────────────────────────────────────────
# API and MCP server ports. Docker Compose sets these automatically.
# API_PORT=3000
# MCP_PORT=3001

# ── Image Storage ────────────────────────────────────────────────────────
# Directory for storing uploaded card images.
# Docker default: /data/images | Local MCP default: ~/.learnforge/images
# IMAGE_PATH=/data/images

# ── MCP Server ───────────────────────────────────────────────────────────
# Public URL of the MCP server (used for OAuth callbacks and image URLs).
# Must include the /mcp path (e.g. https://example.com/mcp).
# MCP_PUBLIC_URL=http://localhost:3001/mcp

# ── Stripe Billing ──────────────────────────────────────────────────────
# Stripe API keys and configuration (required for subscription billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# ── Outgoing Mail (SMTP) ────────────────────────────────────────────────
# Used for e-mail verification, password reset and the subscription lifecycle
# mails (abo confirmed / cancelled / ended). Leave SMTP_HOST empty to
# disable sending entirely — the API then only logs what it would have sent,
# which is what dev and CI run on.
# SMTP_SECURE=true means implicit TLS (port 465); leave false for STARTTLS (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=office@learnforge.eu
SMTP_PASSWORD=
SMTP_FROM=LearnForge <office@learnforge.eu>

# ── App URL ────────────────────────────────────────────────────────────
# Frontend URL for Stripe redirect URLs and for every link inside outgoing mail
# (verification, password reset, billing). Must be the public URL in production.
# APP_URL=http://localhost:5173

# ═════════════════════════════════════════════════════════════════════════
# WEB CONTAINER — runtime variables, read by the container at START, not at build
# ═════════════════════════════════════════════════════════════════════════
#
# The six variables below are consumed by web-ui/docker-entrypoint.sh, which
# substitutes them into the built assets each time the container starts. Vite
# inlines import.meta.env.* as string literals at build time, so the published
# image ships placeholder tokens (__LF_VITE_API_URL__ and friends) and these
# values replace them — which is what keeps ONE image usable in every environment.
#
# The four marked REQUIRED are enforced: the container REFUSES TO START if any is
# empty, rather than serving a literal __LF_OPERATOR_ADDRESS__ on the Impressum.
#
# CHANGING ANY OF THESE NEEDS A RECREATE, NOT A RESTART:
#   docker compose up -d --force-recreate web
# The entrypoint re-substitutes from a pristine copy on every start, so a plain
# `docker restart` does pick changes up too — but `up -d` is what applies an edited
# .env to the container's environment in the first place.

# ── Donation Link (optional; defaults to '#') ────────────────────────────
# Stripe Payment Link for one-time donations (shown in settings + landing page)
VITE_DONATION_URL=https://donate.stripe.com/...

# ── Web UI → API (REQUIRED) ──────────────────────────────────────────────
# Public base URL the BROWSER uses to reach the API. Not an internal container
# address: this value ends up in JavaScript running on the visitor's machine.
VITE_API_URL=http://localhost:3333

# ── Operator / Legal ─────────────────────────────────────────────────────
# Used in Impressum, AGB, Datenschutzerklärung. MUST be set before go-live.
# OPERATOR_ADDRESS is optional (renders empty); the other three are REQUIRED.
OPERATOR_NAME=Your Full Name
OPERATOR_ADDRESS=Street 1
OPERATOR_CITY=1234 City, Austria
OPERATOR_EMAIL=office@learnforge.eu
